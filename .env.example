# Optional. The easiest way to add an AI key is the in-app settings screen (stored in your OS keychain).
# Values here override that screen — useful on servers. .env is git-ignored: never commit real keys.
# Market data needs NO key.

# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEFAULT_LLM_MODEL=gemini/gemini-3.5-flash-lite

# One-time import from an existing AlphaSniper install:  python data_sync.py import-alphasniper
# ALPHASNIPER_DIR=
