# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Market data needs NO key: prices, results and filings come from public NSE files and Screener.in.

# Optional: AI briefs from company filings. Any litellm-supported provider/model works.
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini/gemini-3.5-flash-lite

# Optional, one-time: import history from an existing AlphaSniper install
#   python data_sync.py import-alphasniper
ALPHASNIPER_DIR=
